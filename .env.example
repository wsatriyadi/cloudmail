# Database (PostgreSQL)
DATABASE_URL=postgres://cloudmail:cloudmail@localhost:5432/cloudmail

# Auth - generate with: openssl rand -base64 32
AUTH_SECRET=

# Secret untuk endpoint cleanup via cron (Authorization: Bearer <CRON_SECRET>)
# Kosongkan untuk mewajibkan session admin.
CRON_SECRET=

# Default Admin (hanya digunakan oleh seed script)
ADMIN_EMAIL=admin@cloudmail.local
ADMIN_PASSWORD=changeme

# Worker Communication - generate with: openssl rand -hex 32
WORKER_INGEST_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
