# CloudMail MCP Server Configuration

# CloudMail API Configuration (REQUIRED)
CLOUDMAIL_API_URL=http://192.168.110.9:8090
CLOUDMAIL_API_KEY=your-cloudmail-api-key-here

# Transport Mode: "stdio" or "http"
TRANSPORT_MODE=http

# HTTP Server Configuration (only for http mode)
MCP_PORT=3100

# Authentication Key for Remote Access (recommended for http mode)
# Generate with: openssl rand -hex 32
MCP_AUTH_KEY=your-strong-secret-key-here
